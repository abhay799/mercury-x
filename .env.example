# MERCURY X — Environment Template
# Copy to .env for local use. Never commit real credentials.

MERCURY_ENV=development
MERCURY_LOG_LEVEL=INFO

# Optional external model/provider credentials.
# Leave blank until a provider is intentionally configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_TOKEN=

# Optional remote/cloud worker configuration.
MERCURY_REMOTE_WORKER_URL=
MERCURY_REMOTE_WORKER_TOKEN=

# Optional storage / telemetry endpoints.
MERCURY_ARTIFACT_STORE_URI=
MERCURY_TELEMETRY_ENDPOINT=
